# ===========================================================================
# Local data / generated artifacts
# ===========================================================================

# I DXF non sono versionati per default; le fixture sotto tests/examples/
# vanno aggiunte a mano con `git add -f`.
*.dxf
!tests/examples/**/*.dxf

# disegni reali dei clienti, grezzi: solo locali. In git vanno solo i fogli
# ripuliti di tests/examples/regression/ (controllati con 07_check_client_info.py)
tests/examples/complete_drawings/
# disegni in attesa (da anonimizzare, da aggiungere): grezzi, solo locali
tests/examples/drafts/
tests/examples/to_add_frame/
# sorgenti CAD/PDF dei clienti: in git entrano solo DXF ripuliti
*.dwg
*.DWG
*.SLDDRW
*.SLDPRT

pipeline_output/
output/

# lavoretti manuali usa-e-getta (script diagnostici, disegni reali del
# cliente, dataset di etichette) — mai nel repo, per costruzione
lab/

# ===========================================================================
# Local configuration / secrets
# ===========================================================================

.env
.env.*
!.env.example

# ===========================================================================
# Temporary / backup files
# ===========================================================================

*.log
*.tmp
*.bak
*.orig
*~

# ===========================================================================
# Regole di ruolo di studio/cliente (MAP D17) — nel repo resta solo
# rules/generic.json (il disegno tecnico). Stesso schema di bendly
# calibrations/.
# ===========================================================================

rules/studio_*.json
rules/cliente_*.json
